# WellnessCRM V2 — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# NFR-034: secrets MUST NOT be committed to source control.
# NFR-075: identical configuration shape across environments; only values differ.

# ─── Application ─────────────────────────────────────────────────────────
APP_ENV=local                      # local | staging | production
APP_DEBUG=true                     # MUST be false in staging and production
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────
# The application connects as `app_user`, which does NOT have BYPASSRLS.
# DB §2.4: using the Supabase service-role key for data access would silently
# disable every RLS policy in the system. Never do it.
#
# ⚠️ LAUNCH GATE (DB §2.3): the pooler MUST run in TRANSACTION mode.
# Session-mode pooling with connection reuse breaks `SET LOCAL app.tenant_id`
# tenant isolation. Verify before S1 completes.
DATABASE_URL=postgresql+psycopg://app_user:CHANGEME@localhost:5432/wellnesscrm
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Migrations only — never used at runtime.
DATABASE_MIGRATION_URL=postgresql+psycopg://app_migrator:CHANGEME@localhost:5432/wellnesscrm

# ─── Identity ────────────────────────────────────────────────────────────
# Arch §6.1: THREE SEPARATE SIGNING KEYS, one per realm. A practitioner token
# presented to an operator endpoint must fail signature verification, not merely
# a claim check. Generate with:  openssl rand -base64 48
JWT_SECRET_PRACTITIONER=CHANGEME_practitioner_realm_key
JWT_SECRET_CLIENT=CHANGEME_client_realm_key
JWT_SECRET_OPERATOR=CHANGEME_operator_realm_key

ACCESS_TOKEN_TTL_MINUTES=15        # API §2.1
REFRESH_TOKEN_TTL_DAYS=30          # Approved: ~30 days with secure renewal
MAGIC_LINK_TTL_MINUTES=20          # Approved: 15–30 minutes

# ─── Supabase (infrastructure only — NOT a backend) ──────────────────────
# ADR-02: Supabase provides Postgres, Auth (GoTrue) and Storage. It is never a
# second data path. The service key is used only for Auth/Storage administration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=              # Auth/Storage admin ONLY — never for data access
SUPABASE_STORAGE_BUCKET=wellnesscrm-files

# ─── Worker ──────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=60    # Arch §11.3
WORKER_CONCURRENCY=1               # One worker at MVP; SKIP LOCKED makes >1 safe
WORKER_LEASE_MULTIPLIER=2          # Lease = job timeout × 2 (DB §13.3)

# ─── Observability ───────────────────────────────────────────────────────
# NFR-033: no clinical data, client identifiers or credentials in error reports.
# The Sentry integration sets send_default_pii=False and applies a scrubber.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Integrations (S5+ — not needed for S0/S1) ───────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ─── AI (S8 — not needed for S0/S1) ──────────────────────────────────────
# Provider deliberately deferred to Phase 7 (Arch §9.3).
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# ─── Region ──────────────────────────────────────────────────────────────
# FR-M0-014: regional compliance rules are configuration, never hardcoded logic.
DEFAULT_REGION_CODE=IN
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY_CODE=INR
