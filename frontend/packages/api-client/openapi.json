{
  "components": {
    "schemas": {
      "AcceptedResponse": {
        "description": "🔒 The deliberately uninformative acknowledgement.\n\nReturned by password reset whether or not the address is registered. The\nmessage is phrased conditionally — \"if an account exists\" — so it is honest\nin both cases rather than implying an account was found.",
        "properties": {
          "message": {
            "default": "If an account exists for that address, a reset link is on its way.",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "AcceptedResponse",
        "type": "object"
      },
      "ClientCreateRequest": {
        "description": "FR-M1-004 — name plus one contact method is the whole requirement.\n\n🔒 Everything else is optional. A practitioner capturing a lead mid-call has\na name and a number; a form demanding more is a form they abandon, and\nNFR-011 budgets the whole interaction at three steps.",
