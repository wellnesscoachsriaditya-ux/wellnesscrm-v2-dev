{
  "components": {
    "schemas": {
      "AcceptedResponse": {
        "description": "🔒 The deliberately uninformative acknowledgement.\n\nReturned by password reset whether or not the address is registered. The\nmessage is phrased conditionally — \"if an account exists\" — so it is honest\nin both cases rather than implying an account was found.",
        "properties": {
          "message": {
            "default": "If an account exists for that address, a reset link is on its way.",
            "title": "Message",
            "type": "string"
          }
        },
        "title": "AcceptedResponse",
        "type": "object"
      },
      "DependencyStatus": {
        "description": "State of one dependency.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable",
              "not_configured"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "description": "Process is alive.",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "PasswordResetConfirm": {
        "properties": {
          "password": {
            "maxLength": 256,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          },
          "token": {
            "maxLength": 512,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "password"
        ],
        "title": "PasswordResetConfirm",
        "type": "object"
      },
      "PasswordResetRequest": {
        "properties": {
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "PortalAccessRequest": {
        "properties": {
          "mobile_or_email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Mobile Or Email",
            "type": "string"
          }
        },
        "required": [
          "mobile_or_email"
        ],
        "title": "PortalAccessRequest",
        "type": "object"
      },
      "PortalRedeemRequest": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "PortalRedeemRequest",
        "type": "object"
      },
      "PortalSessionResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/PortalTarget"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in",
          "target"
        ],
        "title": "PortalSessionResponse",
        "type": "object"
      },
      "PortalTarget": {
        "description": "🔒 FR-M7-013 — redemption and navigation in one hop.",
        "properties": {
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "PortalTarget",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness plus dependency detail.\n\n``ready`` reflects only what is *required* to serve traffic. Optional\ndependencies appear in ``dependencies`` and are surfaced to the operator\nconsole (FR-M11-009) without gating the check.",
        "properties": {
          "dependencies": {
            "items": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Dependencies",
            "type": "array"
          },
          "ready": {
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "ready"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "maxLength": 512,
            "minLength": 16,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "description": "API §2.2. 🔒 Password rules are length plus a denylist, not composition.",
        "properties": {
          "accepted_terms_version": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Accepted Terms Version",
            "type": "string"
          },
          "email": {
            "format": "email",
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "mobile": {
            "anyOf": [
              {
                "pattern": "^\\+[1-9][0-9]{1,14}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mobile"
          },
          "password": {
            "maxLength": 256,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          },
          "practice_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Practice Name",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "full_name",
          "practice_name",
          "accepted_terms_version"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "RegisterResponse": {
        "description": "🔒 Carries no tokens and no identifiers.\n\nVerification precedes access (FR-M0-002), and the body is byte-identical\nwhether or not the address was already registered (NFR-043) — returning a\n`tenant_id` on the success path alone would restore the oracle the flat\nresponse exists to remove.",
        "properties": {
          "email_verification_required": {
            "const": true,
            "default": true,
            "title": "Email Verification Required",
            "type": "boolean"
          }
        },
        "title": "RegisterResponse",
        "type": "object"
      },
      "TokenResponse": {
        "description": "What a client needs to make an authenticated request and to renew.\n\n🔒 No user object. The client fetches its own profile from a dedicated\nendpoint; embedding one here would put a name and email in every token\nrefresh and in whatever logs the response passes through.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyEmailRequest": {
        "properties": {
          "token": {
            "maxLength": 512,
            "minLength": 16,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyEmailRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Practice management for Indian nutrition practitioners.\n\n🔒 Realm-segmented paths (ADR-A01): `/app` practitioner, `/portal` client, `/admin` operator, `/public` unauthenticated.",
    "title": "WellnessCRM V2 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/app/auth/logout": {
      "post": {
        "description": "Revoke the current session (NFR-042).\n\n🔒 Authorized, unlike the other authentication routes: this acts on an\nexisting session, so it needs to know whose. The session id comes from the\nverified token, never from the request body — accepting one would let any\nauthenticated caller log out any other.",
        "operationId": "authLogout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/login": {
      "post": {
        "description": "🔒 One error for every failure mode (NFR-043).",
        "operationId": "authLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/password-reset/confirm": {
      "post": {
        "description": "🔒 Revokes every session for the account (NFR-042).",
        "operationId": "authPasswordResetConfirm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set a new password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/password-reset/request": {
      "post": {
        "description": "🔒 202 with an identical body whether or not the address is known.",
        "operationId": "authPasswordResetRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request a password reset",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/refresh": {
      "post": {
        "description": "🔒 DDR-05 — rotate, and revoke the family on reuse.\n\nPublic because a caller with an expired access token must still be able to\nrenew; the refresh token is the credential being presented.",
        "operationId": "authRefresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Rotate the session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/register": {
      "post": {
        "description": "Create a tenant and its owner (FR-M0-001).\n\n🔒 201 with the same body whether the address was free or already taken. The\ndifference is which email the address receives — confirmation, or a \"someone\ntried to register with your address\" notice (API §2.2).",
        "operationId": "authRegister",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register a practice",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/auth/verify-email": {
      "post": {
        "description": "Redeem a verification token and sign the user in (FR-M0-002).",
        "operationId": "authVerifyEmail",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Confirm an email address",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/public/health": {
      "get": {
        "description": "Return 200 if the process is running.\n\n🔒 Deliberately does nothing else. A liveness probe that touches the\ndatabase will fail during a transient database blip and cause the platform\nto restart a perfectly healthy process — turning a brief outage into a\nlonger one.",
        "operationId": "healthLiveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/public/health/ready": {
      "get": {
        "description": "Report whether the application can serve traffic.\n\nReturns 503 when a *required* dependency is unavailable, so the platform\nwithholds traffic rather than serving errors.",
        "operationId": "healthReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/public/portal/access/redeem": {
      "post": {
        "description": "Exchange a magic link for a client session (FR-M0-005).\n\n🔒 Single use and expiry are enforced by the redeeming UPDATE (DDR-04), so\ntwo taps on the same link cannot both open a session.",
        "operationId": "portalAccessRedeem",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortalRedeemRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortalSessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Redeem a portal link",
        "tags": [
          "portal-auth"
        ]
      }
    },
    "/api/v1/public/portal/access/request": {
      "post": {
        "description": "🔒 Self-service link re-request (EC-M7-01).\n\n⚠️ **On the critical path, not an error path.** With a 15–30 minute expiry, a\nclient opening a WhatsApp message an hour later *will* need a new link, and\nthis must never require the practitioner.\n\n🔒 Always 202 with an identical body. Anything else makes this a\nclient-enumeration oracle against a practitioner's client list.\n\n⚠️ Issuing requires resolving an identifier to a client, which is the\n`clients` module's data (S2). Until that module exists this endpoint\ncorrectly acknowledges and sends nothing — the privacy-preserving response is\nidentical to the one it will give for an unknown identifier afterwards.",
        "operationId": "portalAccessRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortalAccessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Request a portal link",
        "tags": [
          "portal-auth"
        ]
      }
    }
  }
}
