      "ClientStage": {
        "description": "The lifecycle — DB §5.2, M1.4. 🟡 Values PROPOSED pending OD-01.\n\n🔒 One entity, seven stages. A ``lead`` and an ``active`` client are the same\nrow; the stage is what differs. That is what makes AC-M1-003 (\"converting a\nlead retains the original record, its identifier, and all prior history\")\ntrue by construction rather than by careful copying.",
        "enum": [
          "lead",
          "contacted",
          "consultation_scheduled",
          "active",
          "paused",
          "churned",
          "archived"
        ],
        "title": "ClientStage",
        "type": "string"
      },
      "DependencyStatus": {
        "description": "State of one dependency.",
