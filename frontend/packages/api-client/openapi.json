  "info": {
    "description": "Practice management for Indian nutrition practitioners.\n\n🔒 Realm-segmented paths (ADR-A01): `/app` practitioner, `/portal` client, `/admin` operator, `/public` unauthenticated.",
    "title": "WellnessCRM V2 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/app/auth/logout": {
      "post": {
        "description": "Revoke the current session (NFR-042).\n\n🔒 Authorized, unlike the other authentication routes: this acts on an\nexisting session, so it needs to know whose. The session id comes from the\nverified token, never from the request body — accepting one would let any\nauthenticated caller log out any other.",
        "operationId": "authLogout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/app/clients": {
      "post": {
        "description": "Create a client or lead — FR-M1-004, AC-M1-001.\n\n🔒 Not metered. FR-M1-003 keeps leads unmetered at every stage before\n``active``, and EC-M2-06 requires a tenant at their limit to keep accepting\nthem. The entitlement binds on the transition to ``active`` (Slice B).",
        "operationId": "clientsCreate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create a client",
        "tags": [
          "clients"
        ]
      }
    },
    "/api/v1/app/clients/{client_id}": {
      "get": {
        "description": "One client by id — API §7.1.\n\n⚠️ Archived clients are returned. AC-M1-007 requires archiving to remove them\nfrom default *views* without deleting anything, and restoring one requires\nbeing able to read it first.",
        "operationId": "clientsRead",
        "parameters": [
          {
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Client Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read a client",
        "tags": [
          "clients"
        ]
      },
      "patch": {
        "description": "Apply a partial edit — API §4.4.\n\n🔒 ``If-Match`` is **required**. Two practitioners editing one client is\nroutine in a clinic, and without a precondition the second save silently\ndiscards the first one's work with no error and no trace.",
        "operationId": "clientsUpdate",
        "parameters": [
          {
            "in": "path",
            "name": "client_id",
            "required": true,
            "schema": {
              "format": "uuid",
